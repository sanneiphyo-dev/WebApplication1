@model ContosoUniversity.AppDbContextModels.Student

@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Student ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3">Enrollment Date</dt>
        <dd class="col-sm-9">@Model.EnrollmentDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Enrollments</dt>
        <dd class="col-sm-9">
            @if (Model.Enrollments != null && Model.Enrollments.Any())
            {
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Course Title</th>
                            <th>Grade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Enrollments)
                        {
                            <tr>
                                <td>@item.Course.Title</td>
                                <td>@(item.Grade.HasValue ? ((Grade)item.Grade.Value).ToString() : "No grade")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <span class="text-muted">No enrollments yet.</span>
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
</div>

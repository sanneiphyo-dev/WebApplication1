@model IEnumerable<ContosoUniversity.AppDbContextModels.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Courses</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus"></i> Create New Course</a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Course ID</th>
                <th>Title</th>
                <th>Credits</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CourseId</td>
                        <td>@item.Title</td>
                        <td>@item.Credits</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.CourseId" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.CourseId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No courses found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

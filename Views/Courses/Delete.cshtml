@model ContosoUniversity.AppDbContextModels.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h2 class="text-danger">Delete Course</h2>
<h4 class="text-secondary">Are you sure you want to delete this course?</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Course ID</dt>
        <dd class="col-sm-9">@Model.CourseId</dd>

        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Credits</dt>
        <dd class="col-sm-9">@Model.Credits</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CourseId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </form>
</div>
